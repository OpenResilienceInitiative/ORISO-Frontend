e:16px;line-height:26px;color:#1d1b1b;mso-line-height-rule:exactly;;">${msg("orisoResetBody1", (properties.orisoPlatformName)!'Online-Beratung')?no_esc}</td></tr><tr><td class="sp" style="padding:0px 40px 28px 40px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:26px;color:#1d1b1b;mso-line-height-rule:exactly;;">${msg("orisoResetBody2", linkExpirationFormatter(linkExpiration))?no_esc}</td></tr><tr><td class="sp btn" align="left" style="padding:20px 40px 0px 40px;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td align="center" bgcolor="${(properties.orisoPrimaryColor)!'#a5000a'}" style="background-color:${(properties.orisoPrimaryColor)!'#a5000a'};border-radius:999px;"><a href="${link}" style="display:inline-block;padding:14px 32px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:16px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:999px;">${msg("orisoResetCtaLabel")?no_esc}</a></td></tr></table></td></tr><tr><td class="sp" style="padding:24px 40px 0px 40px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:14px;line-height:22px;letter-spacing:0.25px;color:#5c5555;">${msg("orisoResetFootnote")?no_esc}</td></tr><tr><td class="sp" style="padding:28px 40px 0px 40px;"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td height="1" bgcolor="#e0dada" style="height:1px;line-height:1px;font-size:0;">&nbsp;</td></tr></table></td></tr><tr><td class="sp" style="padding:16px 40px 32px 40px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#5c5555;">${msg("orisoResetAssurance")?no_esc}</td></tr></table></td></tr><tr><td class="sp" style="padding:28px 40px 0px 40px;font-family:Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif;font-size:12px;line-height:18px;color:#5c5555;word-break:break-word;"><div style="color:#1d1b1b;font-weig