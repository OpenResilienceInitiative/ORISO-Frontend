ARG NODE_VERSION=22.12.0@sha256:0e910f435308c36ea60b4cfd7b80208044d77a074d16b768a81901ce938a62dc
ARG PORT=80

# Build stage
FROM node:$NODE_VERSION AS storybookbuild

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY .npmrc* ./

# Install dependencies with legacy peer deps to resolve conflicts
RUN npm install --legacy-peer-deps --ignore-scripts

# Copy source code
COPY . .

# Build Storybook static files
RUN npm run build-storybook

# Production stage - serve static files
FROM nginx:1.31.3-alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

ARG PORT=80

# CVE-2026-14456, same as in the frontend image: the pinned nginx alpine base
# also carries libssl3/libcrypto3 3.5.7-r0 while Alpine 3.24 ships the fixed
# 3.5.8-r0. The Storybook image has its own Trivy gate, so it needs the same
# upgrade rather than inheriting the frontend one.
RUN apk upgrade --no-cache libssl3 libcrypto3

# Copy Storybook build output to nginx html directory
COPY --from=storybookbuild /app/storybook-static /usr/share/nginx/html

# Copy nginx configuration
RUN echo "server { \
    listen ${PORT}; \
    server_name _; \
    root /usr/share/nginx/html; \
    index index.html; \
    location / { \
        try_files \$uri \$uri/ /index.html; \
    } \
}" > /etc/nginx/conf.d/default.conf

EXPOSE ${PORT}

CMD ["nginx", "-g", "daemon off;"]
